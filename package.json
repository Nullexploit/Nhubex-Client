{
  "name": "nhubex-client",
  "version": "1.0.0",
  "description": "Aplicación de escritorio Nhubex POS",
  "main": "src/main.js",
  "author": "Nhubex",
  "license": "MIT",
  "scripts": {
    "start": "electron --disable-gpu .",
    "dev": "electron --disable-gpu .",
    "build": "electron-builder --publish never",
    "build:win": "electron-builder --win nsis",
    "build:mac": "electron-builder --mac dmg",
    "build:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.nhubex.client",
    "productName": "Nhubex",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": null
  }
}
