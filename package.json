{
  "name": "nhubex-client",
  "version": "1.0.7",
  "description": "Aplicación de escritorio Nhubex POS",
  "main": "src/main.js",
  "desktopName": "com.nhubex.client.desktop",
  "author": "Nhubex",
  "license": "MIT",
  "scripts": {
    "start": "electron --disable-gpu .",
    "dev": "electron --disable-gpu .",
    "test": "node --test tests/printing.test.cjs",
    "test:printing": "electron --disable-gpu tests/printing-electron.cjs",
    "build": "electron-builder --publish never",
    "build:win": "electron-builder --win nsis",
    "build:mac": "electron-builder --mac dmg zip --x64 --arm64",
    "build:linux": "electron-builder --linux AppImage deb --x64",
    "build:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.nhubex.client",
    "productName": "Nhubex",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "icon": "build/icon.png"
    },
    "linux": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "Nhubex",
      "syncDesktopName": true
    },
    "win": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": null
  }
}
